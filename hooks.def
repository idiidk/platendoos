// fastwave: WidgetWaveView::initializeWave -> bl MultiTimer::startTimer(1, 500) (rebuild delay, 2 sites)
HOOK(fastwave_init0, "__ZN6djplay14WidgetWaveView14initializeWaveEllPNS_8SongInfoEPNS_8WaveDataENS_8WaveTypeENS_9ColorTypeENS_8PartFlagEPNS_8BeatInfoEbN8djengine15EnPlayerChannelENS_17WaveNormalizeCoefE", 0, 3, "__ZN4juce10MultiTimer10startTimerEii", -1)
HOOK(fastwave_init1, "__ZN6djplay14WidgetWaveView14initializeWaveEllPNS_8SongInfoEPNS_8WaveDataENS_8WaveTypeENS_9ColorTypeENS_8PartFlagEPNS_8BeatInfoEbN8djengine15EnPlayerChannelENS_17WaveNormalizeCoefE", 1, 3, "__ZN4juce10MultiTimer10startTimerEii", -1)
// fastwave: WidgetWaveView::timerCallback -> bl startTimer(4, 100) (is the build done?) and startTimer(1, 500) (retry)
//   (its 3 bl startTimer calls: (2, 300), (4, 100), (1, 500); a 4th is a "b" tail call)
HOOK(fastwave_check, "__ZN6djplay14WidgetWaveView13timerCallbackEi", 1, 3, "__ZN4juce10MultiTimer10startTimerEii", -1)
HOOK(fastwave_retry, "__ZN6djplay14WidgetWaveView13timerCallbackEi", 2, 3, "__ZN4juce10MultiTimer10startTimerEii", -1)
//   (x86_64: two calls, (4, 100) and (1, 500); the (2, 300) start jumps to the second: the hooks check id and ms)
HOOK_X86(fastwave_check, "__ZN6djplay14WidgetWaveView13timerCallbackEi", 0, 2, "__ZN4juce10MultiTimer10startTimerEii", -1)
HOOK_X86(fastwave_retry, "__ZN6djplay14WidgetWaveView13timerCallbackEi", 1, 2, "__ZN4juce10MultiTimer10startTimerEii", -1)
// fastwave: WidgetPlayerDJ::operateWavePartUpdateMuted -> bl WidgetWaveView::setWavePartSelected (a stem muted/unmuted;
