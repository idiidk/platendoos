// audiomem: rekordbox's FX history buffers (RingBuffer: one new float[n] + bzero for both channels) where they are
//   allocated and freed (the two constructor bodies, getMemory's reallocation, the two destructor bodies), to pin
//   them in memory: the audio thread writes them all the time
HOOK(ring_zero0, "__ZN10RingBufferC2Eii", 0, 1, "stub:_bzero", -1)
HOOK(ring_zero1, "__ZN10RingBufferC1Eii", 0, 1, "stub:_bzero", -1)
HOOK(ring_zero2, "__ZN10RingBuffer9getMemoryEib", 0, 1, "stub:_bzero", -1)
HOOK(ring_free0, "__ZN10RingBufferD2Ev", 0, 1, "stub:__ZdaPv", -1)
HOOK(ring_free1, "__ZN10RingBufferD1Ev", 0, 1, "stub:__ZdaPv", -1)
HOOK(ring_free2, "__ZN10RingBuffer9getMemoryEib", 0, 1, "stub:__ZdaPv", -1)
// audiomem: a deck's audio (rbxfrm::PageBuffer<Float4>: numPages chunks of pageSize * 16 bytes). The three places
//   that build one (PagingAudioSource's two constructor bodies, setReader), and inside the constructor each
//   chunk's new[] and bzero, and its delete[] in the destructor
HOOK(pagebuf_ctor0, "__ZN6rbxfrm17PagingAudioSourceC2EiiiPNS_17BufferingStrategyEiN4juce6Thread8PriorityEib", 0, 1, "__ZN6rbxfrm10PageBufferINS_6Float4EiEC2Eii", -1)
HOOK(pagebuf_ctor1, "__ZN6rbxfrm17PagingAudioSourceC1EiiiPNS_17BufferingStrategyEiN4juce6Thread8PriorityEib", 0, 1, "__ZN6rbxfrm10PageBufferINS_6Float4EiEC2Eii", -1)
HOOK(pagebuf_ctor2, "__ZN6rbxfrm17PagingAudioSource9setReaderENS_18RefCountedObjExPtrINS_14AbstractReaderEEEPNS_20IAudioSourceListenerE", 0, 1, "__ZN6rbxfrm10PageBufferINS_6Float4EiEC2Eii", -1)
HOOK(pagebuf_new, "__ZN6rbxfrm10PageBufferINS_6Float4EiEC2Eii", 0, 2, "stub:__Znam", -1)
HOOK(pagebuf_zero, "__ZN6rbxfrm10PageBufferINS_6Float4EiEC2Eii", 0, 1, "stub:_bzero", -1)
HOOK(pagebuf_free, "__ZN6rbxfrm10PageBufferINS_6Float4EiED2Ev", 0, 1, "stub:__ZdaPv", -1)
//   (x86_64: the zeroing is ___bzero, the two destructors tail-call delete[] ("pop rbp; jmp"), and PageBuffer's
//   chunks come from posix_memalign(&p, 16, n) and go back with free: the loop's call is the first of the
//   destructor's nine, a tenth is its tail jmp. getMemory's delete[] and the three constructor calls are as on arm64)
HOOK_X86(ring_zero0, "__ZN10RingBufferC2Eii", 0, 1, "stub:___bzero", -1)
HOOK_X86(ring_zero1, "__ZN10RingBufferC1Eii", 0, 1, "stub:___bzero", -1)
HOOK_X86(ring_zero2, "__ZN10RingBuffer9getMemoryEib", 0, 1, "stub:___bzero", -1)
HOOK_X86(ring_free0, "__ZN10RingBufferD2Ev", 0, 1, "stub:__ZdaPv", -2)
