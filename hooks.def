// flx4: DeviceMidi::run (a controller's MIDI thread) -> bl midiInDataForThread, for every message from the controller
//   (it handles the time-critical ones, e.g. jog wheels, there; the rest go on to the main thread)
HOOK(midi_in, "__ZN6djplay10DeviceMidi3runEv", 0, 1, "__ZN6djplay10DeviceMidi19midiInDataForThreadERN4juce11MidiMessageE", -1)
// flx4: every message to a controller, as it goes out: juce::MidiOutput::sendMessageNow from MidiOutputHelper::run
//   (its three queues: a repeated message, timed messages e.g. the level meters, the LEDs by priority) and from
//   MidiOutputBackgroundThread::run (the queues' timed sends, when the device has that thread)
HOOK(midi_send1, "__ZN6djplay16MidiOutputHelper3runEv", 0, 3, "__ZN4juce10MidiOutput14sendMessageNowERKNS_11MidiMessageE", -1)
HOOK(midi_send2, "__ZN6djplay16MidiOutputHelper3runEv", 1, 3, "__ZN4juce10MidiOutput14sendMessageNowERKNS_11MidiMessageE", -1)
HOOK(midi_send3, "__ZN6djplay16MidiOutputHelper3runEv", 2, 3, "__ZN4juce10MidiOutput14sendMessageNowERKNS_11MidiMessageE", -1)
HOOK(midi_send4, "__ZN6djplay26MidiOutputBackgroundThread3runEv", 0, 1, "__ZN4juce10MidiOutput14sendMessageNowERKNS_11MidiMessageE", -1)
// flx4: MidiMap::create -> bl MidiMapDDJFLX4's constructor (the FLX4's mapping; the mod adds decks 3/4's jog processors)
HOOK(flx4_map, "__ZN6djplay7MidiMap6createEiN4juce6StringE", 0, 1, "__ZN6djplay14MidiMapDDJFLX4C2EiN4juce6StringE", -1)
// spotifyapi: Service::getPlaylistTracks holds Service's API lock (+0x148) around DjAPI::getTracks, the HTTP request
//   itself, so every Spotify track-list request waits for the one before: lock, unlock, unlock in the unwind path
HOOK(sp_tracks_enter, "__ZN9streaming7spotify7Service17getPlaylistTracksERKN4juce6StringEii", 0, 2, "__ZNK4juce15CriticalSection5enterEv", -1)
//   7.2.20: the 401 handling with its listener lock moved out to Service::logoutIfUnauthorized, so one lock is left here
HOOK_OR(sp_tracks_enter, "__ZN9streaming7spotify7Service17getPlaylistTracksERKN4juce6StringEii", 0, 1, "__ZNK4juce15CriticalSection5enterEv", -1)
HOOK(sp_tracks_exit, "__ZN9streaming7spotify7Service17getPlaylistTracksERKN4juce6StringEii", 0, 4, "__ZNK4juce15CriticalSection4exitEv", -1)
HOOK_OR(sp_tracks_exit, "__ZN9streaming7spotify7Service17getPlaylistTracksERKN4juce6StringEii", 0, 2, "__ZNK4juce15CriticalSection4exitEv", -1)
HOOK(sp_tracks_unwind, "__ZN9streaming7spotify7Service17getPlaylistTracksERKN4juce6StringEii", 3, 4, "__ZNK4juce15CriticalSection4exitEv", -1)
HOOK_OR(sp_tracks_unwind, "__ZN9streaming7spotify7Service17getPlaylistTracksERKN4juce6StringEii", 1, 2, "__ZNK4juce15CriticalSection4exitEv", -1)
// spotifyapi: the same in Service::getLookupTracks (tracks by id)
HOOK(sp_lookup_enter, "__ZN9streaming7spotify7Service15getLookupTracksERKN4juce11StringArrayEii", 0, 2, "__ZNK4juce15CriticalSection5enterEv", -1)
HOOK_OR(sp_lookup_enter, "__ZN9streaming7spotify7Service15getLookupTracksERKN4juce11StringArrayEii", 0, 1, "__ZNK4juce15CriticalSection5enterEv", -1)
HOOK(sp_lookup_exit, "__ZN9streaming7spotify7Service15getLookupTracksERKN4juce11StringArrayEii", 0, 4, "__ZNK4juce15CriticalSection4exitEv", -1)
HOOK_OR(sp_lookup_exit, "__ZN9streaming7spotify7Service15getLookupTracksERKN4juce11StringArrayEii", 0, 2, "__ZNK4juce15CriticalSection4exitEv", -1)
HOOK(sp_lookup_unwind, "__ZN9streaming7spotify7Service15getLookupTracksERKN4juce11StringArrayEii", 3, 4, "__ZNK4juce15CriticalSection4exitEv", -1)
HOOK_OR(sp_lookup_unwind, "__ZN9streaming7spotify7Service15getLookupTracksERKN4juce11StringArrayEii", 1, 2, "__ZNK4juce15CriticalSection4exitEv", -1)
// spotifyapi: SingletonHolder<BridgeThreadPool>::get -> bl ThreadPool::ThreadPool(3 threads, ...): every streaming
