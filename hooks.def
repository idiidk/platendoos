HOOK(bridge_pool, "__ZN4juce15SingletonHolderIN15StreamingHelper16BridgeThreadPoolENS_15CriticalSectionELb1EE3getEv", 0, 1, "__ZN4juce10ThreadPoolC2EimNS_6Thread8PriorityE", -1)
