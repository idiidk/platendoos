HOOK(fastwave_muted, "__ZN6djplay14WidgetPlayerDJ26operateWavePartUpdateMutedEv", 0, 1, "__ZN6djplay14WidgetWaveView19setWavePartSelectedEbbbb", -1)
HOOK(fastwave_resize, "__ZN6djplay14WidgetWaveView12resizedFrameEv", 0, 1, "__ZN4juce10MultiTimer10startTimerEii", -1)
